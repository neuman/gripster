{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Gripster site — Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173/",
      "webRoot": "${workspaceFolder}/site",
      "preLaunchTask": "vite: dev (gripster site)",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "/src/*": "${workspaceFolder}/site/src/*"
      }
    },
    {
      "name": "Gripster site — Edge",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173/",
      "webRoot": "${workspaceFolder}/site",
      "preLaunchTask": "vite: dev (gripster site)",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "/src/*": "${workspaceFolder}/site/src/*"
      }
    }
  ]
}
