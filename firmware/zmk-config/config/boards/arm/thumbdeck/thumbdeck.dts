/*
 * thumbdeck.dts — ZMK board for the bare Ebyte E73-2G4M08S1C (nRF52840) soldered
 * directly to the thumbdeck PCB. Flash partitions copied VERBATIM from nice!nano v2
 * (Adafruit nRF52840 UF2 bootloader layout: SoftDevice @0x0, app @0x26000, settings
 * storage @0xec000, bootloader @0xf4000) so the Adafruit bootloader (flashed once
 * over SWD) works drag-and-drop after.
 * The matrix (kscan + transform) is in the GENERATED thumbdeck.dtsi. High-voltage
 * power mode: the cell drives VDDH; VDD is the internal REG0 3.3V output.
 *   >>> VALIDATE WITH THE ZMK GITHUB-ACTIONS BUILD before trusting for fab. <<<
 */
/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include "thumbdeck.dtsi"

/ {
    model = "thumbdeck";
    compatible = "thumbdeck";

    chosen {
        zephyr,code-partition = &code_partition;
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zmk,battery = &vbatt;
    };

    /* battery sense: 1M/1M divider on P0.02/AIN0 (E73 pin 7 = VBAT_SENSE) */
    vbatt: vbatt {
        compatible = "zmk,battery-voltage-divider";
        io-channels = <&adc 0>;
        output-ohms = <1000000>;
        full-ohms = <2000000>;
    };
};

&adc { status = "okay"; };
&gpiote { status = "okay"; };
&gpio0 { status = "okay"; };
&gpio1 { status = "okay"; };
&usbd { status = "okay"; };

/* nice!nano v2 / Adafruit nRF52840 bootloader flash layout (labels mirror
 * zmk/app/boards/arm/nice_nano/nice_nano.dtsi at v0.3.0). CONFIG_USE_DT_CODE_PARTITION
 * links the app at &code_partition (0x26000), after the S140 SoftDevice. */
&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        sd_partition: partition@0 {
            reg = <0x00000000 0x00026000>;
        };
        code_partition: partition@26000 {
            reg = <0x00026000 0x000c6000>;
        };

        storage_partition: partition@ec000 {
            reg = <0x000ec000 0x00008000>;
        };

        boot_partition: partition@f4000 {
            reg = <0x000f4000 0x0000c000>;
        };
    };
};
