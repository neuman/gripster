/*
 * thumbdeck.dts — ZMK board for the bare Ebyte E73-2G4M08S1C (nRF52840) soldered
 * directly to the thumbdeck PCB. Flash partitions copied VERBATIM from nice!nano v2
 * (Adafruit nRF52840 UF2 bootloader layout: SoftDevice @0x0, app @0x26000, settings
 * storage @0xec000, bootloader @0xf4000) so the Adafruit bootloader (flashed once
 * over SWD) works drag-and-drop after.
 * The matrix (kscan + transform) is in the GENERATED thumbdeck.dtsi. High-voltage
 * power mode: the cell drives VDDH; VDD is the internal REG0 3.3V output.
 *   >>> VALIDATE WITH THE ZMK GITHUB-ACTIONS BUILD before trusting for fab. <<<
 */
/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include "thumbdeck.dtsi"

/ {
    model = "thumbdeck";
    compatible = "thumbdeck";

    chosen {
        zephyr,code-partition = &code_partition;
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zmk,battery = &vbatt;
    };

    /* battery sense: 1M/1M divider on P0.02/AIN0 (E73 pin 7 = VBAT_SENSE) */
    vbatt: vbatt {
        compatible = "zmk,battery-voltage-divider";
        io-channels = <&adc 0>;
        output-ohms = <1000000>;
        full-ohms = <2000000>;
    };

    /* v0.21 (Bean-style hall nub): the pointing nub's input listener — the
     * sensor itself lives on &i2c0 below. Rate-control pointing: the driver
     * (firmware/zmk-modules/tmag5273_nub) maps magnet deflection to cursor
     * VELOCITY, ThinkPad-style. */
    nub_listener: nub_listener {
        compatible = "zmk,input-listener";
        device = <&nub>;
    };
};

/* Spare-I2C pads finally used for what they were reserved for: SDA = E73 pad
 * 15 (P0.05), SCL = pad 4 (P0.28). TWIM0. The TMAG5273's INT (pad 8/P0.29)
 * is wired on the board but the driver polls; INT stays available. */
&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 5)>,
                    <NRF_PSEL(TWIM_SCL, 0, 28)>;
        };
    };
    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 5)>,
                    <NRF_PSEL(TWIM_SCL, 0, 28)>;
            low-power-enable;
        };
    };
};

&i2c0 {
    compatible = "nordic,nrf-twim";
    status = "okay";
    clock-frequency = <I2C_BITRATE_FAST>;
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";

    nub: tmag5273@35 {
        compatible = "thumbdeck,tmag5273-nub";
        reg = <0x35>;
        sampling-hz = <100>;
        deadzone = <150>;
        gain-num = <1>;
        gain-div = <3500>;
        max-out = <12>;
        calib-samples = <32>;
        /* axis orientation is a first-article calibration: flip/swap here */
    };
};

&adc { status = "okay"; };
&gpiote { status = "okay"; };
&gpio0 { status = "okay"; };
&gpio1 { status = "okay"; };
&usbd { status = "okay"; };

/* nice!nano v2 / Adafruit nRF52840 bootloader flash layout (labels mirror
 * zmk/app/boards/arm/nice_nano/nice_nano.dtsi at v0.3.0). CONFIG_USE_DT_CODE_PARTITION
 * links the app at &code_partition (0x26000), after the S140 SoftDevice. */
&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        sd_partition: partition@0 {
            reg = <0x00000000 0x00026000>;
        };
        code_partition: partition@26000 {
            reg = <0x00026000 0x000c6000>;
        };

        storage_partition: partition@ec000 {
            reg = <0x000ec000 0x00008000>;
        };

        boot_partition: partition@f4000 {
            reg = <0x000f4000 0x0000c000>;
        };
    };
};
