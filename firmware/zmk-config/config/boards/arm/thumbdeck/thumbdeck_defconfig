CONFIG_SOC_SERIES_NRF52X=y
CONFIG_SOC_NRF52840_QIAA=y
CONFIG_BOARD_THUMBDECK=y
CONFIG_ARM_MPU=y
CONFIG_PINCTRL=y

# LF clock: the bare E73 module has NO 32.768kHz crystal (and P0.00/XL1 is used
# as a matrix column), so LFCLK must come from the internal RC oscillator —
# without this the clock driver blocks waiting for a crystal and BLE never starts.
CONFIG_CLOCK_CONTROL_NRF=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_500PPM=y

# nRF52840 native USB + BLE (ZMK)
CONFIG_ZMK_USB=y
CONFIG_ZMK_BLE=y
CONFIG_USB_DEVICE_STACK=y
CONFIG_USB_DEVICE_INITIALIZE_AT_BOOT=n

# Adafruit UF2 bootloader compatibility
CONFIG_BUILD_OUTPUT_UF2=y
CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BOOTLOADER_MCUBOOT=n

CONFIG_GPIO=y
CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_MAP=y
CONFIG_FLASH_PAGE_LAYOUT=y

# Note: no CONFIG_BOARD_ENABLE_DCDC here — the symbol is not defined for this
# board (setting it is a hard Kconfig error), and the bare E73 has no external
# DCDC inductors, so the nRF52840 must stay in LDO mode anyway. High-voltage
# regulator output = 3.3V (REGOUT0); UICR set once over SWD if blank.

# v0.21 pointing nub: TWIM0 to the TMAG5273 hall sensor (the in-tree
# tmag5273_nub module is default-y once these + its DT node exist)
CONFIG_I2C=y
CONFIG_INPUT=y
