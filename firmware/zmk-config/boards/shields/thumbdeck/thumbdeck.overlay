/*
 * thumbdeck.overlay — single-controller (non-split) 5x10 thumb keyboard (v0.3).
 *
 * One nRF52840 (nice!nano v2) in the RIGHT grip scans all 50 keys as a single
 * 5 row x 10 column matrix. Logical columns 0..4 = RIGHT grip (local wiring),
 * columns 5..9 = LEFT grip, reached over the bridge cable. No split, no second
 * controller, no col-offset.
 *
 * Bridge cable = 10 conductors: 5 shared rows (pro_micro 4,5,6,7,8) + the LEFT
 * grip's 5 columns (pro_micro 18,19,20,21,1). RIGHT columns (9,10,14,15,16) are
 * local. Pins use the &pro_micro nexus so this is board-portable; 15 of the
 * nice!nano's ~18 usable GPIO, leaving 0/2/3 free (2/3 = I2C for the optional
 * MCP23017 bridge-expander variant). See docs/matrix-and-diodes.md.
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
	chosen {
		zmk,kscan = &kscan0;
		zmk,matrix_transform = &default_transform;
	};

	default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <10>;
		rows = <5>;
		map = <
			RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)   RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
			RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)   RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
			RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)   RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
			RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4)   RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9)
			RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4)   RC(4,5) RC(4,6) RC(4,7) RC(4,8) RC(4,9)
		>;
	};

	kscan0: kscan {
		compatible = "zmk,kscan-gpio-matrix";
		diode-direction = "col2row";

		/* Debounce raised for the long bridge cable (EE review #2): rejects
		 * cable-capacitance / crosstalk chatter. Pair with external row
		 * pull-downs + column series resistors + shielded flex (see BOM). */
		debounce-press-ms = <8>;
		debounce-release-ms = <8>;

		/* rows: read, shared across both grips (5 wires over the bridge) */
		row-gpios
			= <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			, <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			, <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			, <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			, <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			;

		/* cols: driven. 0..4 RIGHT grip (local); 5..9 LEFT grip (over bridge) */
		col-gpios
			= <&pro_micro  9 GPIO_ACTIVE_HIGH>   /* c0 R */
			, <&pro_micro 10 GPIO_ACTIVE_HIGH>   /* c1 R */
			, <&pro_micro 14 GPIO_ACTIVE_HIGH>   /* c2 R */
			, <&pro_micro 15 GPIO_ACTIVE_HIGH>   /* c3 R */
			, <&pro_micro 16 GPIO_ACTIVE_HIGH>   /* c4 R */
			, <&pro_micro 18 GPIO_ACTIVE_HIGH>   /* c5 L (bridge) */
			, <&pro_micro 19 GPIO_ACTIVE_HIGH>   /* c6 L (bridge) */
			, <&pro_micro 20 GPIO_ACTIVE_HIGH>   /* c7 L (bridge) */
			, <&pro_micro 21 GPIO_ACTIVE_HIGH>   /* c8 L (bridge) */
			, <&pro_micro  1 GPIO_ACTIVE_HIGH>   /* c9 L (bridge) */
			;
	};
};
