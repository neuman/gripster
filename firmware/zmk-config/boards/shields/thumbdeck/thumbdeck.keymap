/*
 * thumbdeck.keymap — placeholder default layer (i8+-inspired QWERTY).
 *
 * 50 bindings, row-major over the single 5x10 matrix. Per-row order is
 * RIGHT grip (logical cols 0..4, local wiring) then LEFT grip (cols 5..9, over
 * the bridge cable). One controller scans all of it — no split. Legends match
 * the render:
 *   RIGHT: 6 7 8 9 0 / Y U I O P / H J K L ENT / N M , . / / SPC ARROWS
 *   LEFT : 1 2 3 4 5 / Q W E R T / A S D F G / Z X C V B / CTL GUI ALT SPC FN
 * Layout is provisional until the KiCad layout freezes (Section 7 loop output).
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
	keymap {
		compatible = "zmk,keymap";

		default_layer {
			bindings = <
/* logical cols:  0    1    2    3     4   | 5(inner of L) ......... 9(outer) */
/* r0  RIGHT: 6 7 8 9 0            LEFT(inner->outer): 5 4 3 2 1 */
   &kp N6   &kp N7   &kp N8   &kp N9    &kp N0      &kp N5    &kp N4   &kp N3   &kp N2  &kp N1
/* r1  RIGHT: Y U I O P            LEFT: T R E W Q */
   &kp Y    &kp U    &kp I    &kp O     &kp P       &kp T     &kp R    &kp E    &kp W   &kp Q
/* r2  RIGHT: H J K L ENTER        LEFT: G F D S A */
   &kp H    &kp J    &kp K    &kp L     &kp ENTER   &kp G     &kp F    &kp D    &kp S   &kp A
/* r3  RIGHT: N M , . /            LEFT: B V C X Z */
   &kp N    &kp M    &kp COMMA &kp DOT  &kp FSLH    &kp B     &kp V    &kp C    &kp X   &kp Z
/* r4  RIGHT: SPC <- v ^ ->        LEFT: SPC ALT GUI CTL FN(mo 1) */
   &kp SPACE &kp LEFT &kp DOWN &kp UP   &kp RIGHT   &kp SPACE &kp LALT &kp LGUI &kp LCTRL &mo 1
			>;
		};

		fn_layer {
			bindings = <
   &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &trans   &trans &trans &trans &trans &trans
   &trans     &trans       &trans       &trans       &trans   &trans &trans &trans &trans &trans
   &trans     &trans       &trans       &trans       &trans   &trans &trans &trans &trans &trans
   &trans     &trans       &trans       &trans       &trans   &trans &trans &trans &trans &trans
   &trans     &trans       &trans       &trans       &trans   &trans &trans &trans &trans &trans
			>;
		};
	};
};
