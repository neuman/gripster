            &kp F5  &kp F4  &kp F3  &kp F2  &kp F1  &kp ESC  &kp N5  &kp N4  &kp N3  &kp N2
            &kp N1  &kp GRAVE  &kp T  &kp R  &kp E  &kp W  &kp Q  &kp TAB  &kp G  &kp F
            &kp D  &kp S  &kp A  &kp CAPS  &kp B  &kp V  &kp C  &kp X  &kp Z  &kp LSHFT
            &kp SPACE  &kp LALT  &kp LGUI  &mo 1  &kp LCTRL  &kp RET  &kp UP  &kp DOWN  &kp LEFT  &kp RIGHT
            &mkp LCLK  &mkp RCLK
/* RIGHT grip (37 keys) */
            &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp DEL  &kp N6  &kp N7  &kp N8  &kp N9
            &kp N0  &kp BSPC  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp SEMI  &kp H  &kp J
            &kp K  &kp L  &kp SQT  &kp RET  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp LSHFT
            &kp SPACE  &kp RALT  &kp LBKT  &kp RBKT  &kp BSLH  &kp PG_UP  &kp PG_DN
			>;
		};
		fn_layer {
			bindings = <
            &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans
            &bootloader  &sys_reset  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans
			>;
		};
	};
